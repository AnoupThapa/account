# ---------------------------------------------------------------------------
# LedgerPro configuration. Copy to .env and change every secret before production.
# NEVER commit .env. Values below are for LOCAL DEVELOPMENT only.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Database: migrations run as the owner; the app connects as ledger_app (row-level security applies)
DATABASE_ADMIN_URL=postgres://ledger_owner:ledger_owner_dev@localhost:5432/ledgerpro
DATABASE_URL=postgres://ledger_app:ledger_app_dev@localhost:5432/ledgerpro
TEST_DATABASE_ADMIN_URL=postgres://ledger_owner:ledger_owner_dev@localhost:5432/ledgerpro_test
TEST_DATABASE_URL=postgres://ledger_app:ledger_app_dev@localhost:5432/ledgerpro_test
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# 64+ random characters each. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789abcdefghijklmnop
# 32-byte key (base64) for AES-256-GCM encryption of 2FA secrets & tokens:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=ZGV2LW9ubHktZGV2LW9ubHktZGV2LW9ubHktZGV2LW8=
# Cookies need HTTPS in production (true); false only for http://localhost
COOKIE_SECURE=false
# 2FA is mandatory for Admin/Checker/Finance Manager (security.md §1). Only set false on a laptop for demos.
ENFORCE_2FA=true
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
IDLE_TIMEOUT_MINUTES=30

# Email (password reset, lockout alerts). Leave SMTP_HOST empty to print emails to the worker log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LedgerPro <no-reply@example.com>"

# PDF rendering (Chromium). Leave empty to use Playwright's bundled browser.
CHROMIUM_PATH=

# Web
NEXT_PUBLIC_APP_NAME=LedgerPro
API_INTERNAL_URL=http://localhost:4000
