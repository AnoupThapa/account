{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_ADMIN_URL",
    "TEST_DATABASE_URL",
    "TEST_DATABASE_ADMIN_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "ENCRYPTION_KEY",
    "CHROMIUM_PATH",
    "API_INTERNAL_URL",
    "NODE_ENV",
    "NEXT_STANDALONE",
    "NEXT_TELEMETRY_DISABLED"
  ]
}
